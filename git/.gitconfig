[user]
	name = ajay
	email = example@gmail.com
[init]
	defaultBranch = main
[core]
	pager = delta
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	light = false
	side-by-side = true
	line-numbers = true
	syntax-theme = ansi
[merge]
	conflictStyle = zdiff3
[diff]
	colorMoved = default
[pull]
	rebase = true
[fetch]
	prune = true
[push]
	autoSetupRemote = true
[rebase]
	autoStash = true
[column]
	ui = auto
[branch]
	sort = -committerdate
[alias]
	s = status -sb
	co = checkout
	cob = checkout -b
	br = branch
	ci = commit
	cm = commit -m
	amend = commit --amend --no-edit
	aa = add -A
	unstage = reset HEAD --
	last = log -1 HEAD --stat
	lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
	lol = log --oneline --graph --decorate -20
	undo = reset --soft HEAD~1
	cleanup = !git branch --merged | grep -v '\\*\\|main\\|master' | xargs -n 1 -r git branch -d
	aliases = config --get-regexp '^alias\\.'
# GitHub auth: run `gh auth setup-git` on each machine (adds the credential helper)
